{
  "extraKnownMarketplaces": {
    "aiqt-guardrails": {
      "source": { "source": "directory", "path": "./plugin" }
    }
  },
  "enabledPlugins": {
    "aiqt-guardrails-hooks@aiqt-guardrails": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask_mode_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
