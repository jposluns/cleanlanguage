  Content-Disposition: attachment; filename="cleanlanguage-11k.md"
  X-Robots-Tag: noindex

/downloads/cleanlanguage-8k.md
  Content-Disposition: attachment; filename="cleanlanguage-8k.md"
  X-Robots-Tag: noindex

